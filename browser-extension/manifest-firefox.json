{
  "manifest_version": 3,
  "name": "Send to Download Craft",
  "version": "0.9.2",
  "description": "Automatically sends downloads to your Download Craft download manager.",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "downloads",
    "storage",
    "scripting",
    "tabs",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "rank.js",
        "content.js"
      ],
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "send-to-download-craft@example",
      "strict_min_version": "121.0"
    }
  }
}
